.LOGON tdprod/etl_mkt,$PASSWORD;
.SET ERROROUT STDOUT
.SET WIDTH 200

/* Cadena mensual de marketing (cron 05:00 dia 2 de cada mes) */
DATABASE EDW_MKT;

EXEC EDW_MKT.M_CARGA_USO_MENSUAL('202609');
.IF ERRORCODE <> 0 THEN .GOTO ERROR_USO

.RUN FILE = /etl/mkt/sql/04_upd_respuesta_campana.sql
.IF ERRORCODE <> 0 THEN .GOTO ERROR_CAMP

CALL EDW_MKT.SP_SEGMENTACION_VALOR('202609');
.IF ACTIVITYCOUNT = 0 THEN .GOTO AVISO_VACIO

.EXPORT REPORT FILE = /etl/mkt/out/kpi_campanas_202609.txt
SEL * FROM EDW_MKT.V_KPI_CAMPANAS ORDER BY ROI DESC;
.EXPORT RESET

.LOGOFF
.QUIT 0

.LABEL AVISO_VACIO
.OS mailx -s "SEGMENTACION VACIA 202609" bi-mkt@empresa.example < /dev/null
.QUIT 4
.LABEL ERROR_USO
.QUIT 8
.LABEL ERROR_CAMP
.QUIT 12
